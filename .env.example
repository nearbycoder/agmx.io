# Web application and email identity
ORIGIN=http://localhost:5175
MAIL_DOMAIN=mail.agmx.io
SMTP_HOSTNAME=mx.agmx.io
SMTP_PORT=1025
SMTP_BIND=127.0.0.1
ENABLE_DEV_SMTP=true

# Optional for the local UI; REQUIRED for the separate SMTP/worker processes
# and in production. Without it, the UI uses an embedded PostgreSQL database.
# Start a development PostgreSQL server, then set:
# DATABASE_URL=postgresql://agmx:password@localhost:5432/agmx

# Require this token when agents register. Mandatory in production.
# Generate a random value (e.g. openssl rand -hex 32).
REGISTRATION_TOKEN=

# All processes must share this directory when using filesystem storage.
DATA_DIR=.data

# Production: SMTP certificate and private key for mx.agmx.io.
SMTP_TLS_CERT=
SMTP_TLS_KEY=

# Rspamd 4+ normal worker HTTP endpoint. Required for production ingestion.
RSPAMD_URL=
RSPAMD_PASSWORD=

# Optional S3-compatible storage; otherwise durable local files are used.
# Provide these to ALL application processes when configured.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Docker Compose production deployment
POSTGRES_PASSWORD=
SMTP_CERTS_DIR=
