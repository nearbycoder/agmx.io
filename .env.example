# ─── Core ────────────────────────────────────────────────────────────────────
# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agmx
# Public URL of this deployment (no trailing slash). Falls back to RAILWAY_PUBLIC_DOMAIN.
APP_URL=http://localhost:3100
# Long random string used to sign sessions:  openssl rand -base64 48
BETTER_AUTH_SECRET=change-me

# ─── Mail ────────────────────────────────────────────────────────────────────
# Domain your agents' inboxes live on, e.g. scout@agmx.io
MAIL_DOMAIN=agmx.io
# "ses" sends real mail (default when AWS keys are present); "log" prints mail to the console.
MAIL_TRANSPORT=log
# Sender for magic links / password resets. Must be on a verified SES identity.
SYSTEM_FROM="AGMX <no-reply@agmx.io>"

# ─── Access ──────────────────────────────────────────────────────────────────
# Comma-separated emails (or *@company.com patterns) allowed to sign in.
# Leave empty to allow anyone to sign up.
ALLOWED_EMAILS=you@example.com
# Operators: admin role + the Unlimited plan.
ADMIN_EMAILS=you@example.com
# Plan for new users: free | pro | scale | unlimited
DEFAULT_PLAN=free
# Let agents request inboxes via POST /api/v1/signup (a human still approves). true | false
ENABLE_AGENT_SIGNUPS=true

# ─── Amazon SES ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: configuration set whose event destination (SNS) reports bounces/complaints/deliveries.
SES_CONFIGURATION_SET=
# Optional: lock the inbound webhook to specific SNS topic ARNs (comma-separated).
SES_INBOUND_TOPIC_ARNS=
# Optional: receipt rule that lists explicit recipient domains; custom domains are added/removed automatically.
SES_RECEIPT_RULE_SET=
SES_RECEIPT_RULE=

# ─── Development ─────────────────────────────────────────────────────────────
# Enables POST /api/dev/inbound to inject test mail (always on outside production).
ENABLE_DEV_INBOUND=false
