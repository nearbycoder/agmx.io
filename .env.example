# ─── Core ────────────────────────────────────────────────────────────────────
# Postgres connection string. In Coolify, copy the internal URL from your PostgreSQL resource.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agmx
# Public URL of this deployment (no trailing slash).
APP_URL=http://localhost:3100
# Long random string used to sign sessions:  openssl rand -base64 48
BETTER_AUTH_SECRET=change-me

# ─── Mail ────────────────────────────────────────────────────────────────────
# Domain your agents' inboxes live on, e.g. scout@bot.example.com. A subdomain keeps your
# root domain free for human mail and isolates agent sending reputation.
MAIL_DOMAIN=bot.example.com
# Optional brand domain where only operators (ADMIN_EMAILS) can create inboxes, e.g. admin@example.com.
# Its MX must also point at SES and it must be in the SES receipt rule.
OPERATOR_DOMAIN=example.com
# "ses" sends real mail (default when AWS keys are present); "log" prints mail to the console.
MAIL_TRANSPORT=log
# Sender for magic links / password resets. Must be on a verified SES identity.
SYSTEM_FROM="AGMX <no-reply@example.com>"
# Who runs this instance, named in /terms and /privacy (e.g. your company). Defaults to "AGMX".
OPERATOR_NAME="Example Inc."
# Role mailboxes (RFC 2142) created automatically for the first operator in ADMIN_EMAILS, on
# OPERATOR_DOMAIN (or MAIL_DOMAIN). They show up in the dashboard under an "Operator" agent and
# are the contacts listed in /terms and /privacy. Set to an empty string to disable.
SYSTEM_INBOXES=abuse,postmaster,privacy

# ─── Access ──────────────────────────────────────────────────────────────────
# Comma-separated emails (or *@company.com patterns) allowed to sign in.
# Leave empty to allow anyone to sign up.
ALLOWED_EMAILS=you@example.com
# Operators: admin role + the Unlimited plan.
ADMIN_EMAILS=you@example.com
# Plan for new users: free | pro | scale | unlimited
DEFAULT_PLAN=free
# Let agents request inboxes via POST /api/v1/signup (a human still approves). true | false
ENABLE_AGENT_SIGNUPS=true

# ─── Amazon SES ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: configuration set whose event destination (SNS) reports bounces/complaints/deliveries.
SES_CONFIGURATION_SET=
# The SNS topic ARNs the inbound webhook accepts (comma-separated). Required in production:
# set it before you subscribe the topic, or the subscription confirmation is refused.
SES_INBOUND_TOPIC_ARNS=
# Optional: receipt rule that lists explicit recipient domains; custom domains are added/removed automatically.
SES_RECEIPT_RULE_SET=
SES_RECEIPT_RULE=

# ─── Attachment storage ──────────────────────────────────────────────────────
# "s3" stores attachment bytes in any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) and serves
# downloads via short-lived signed URLs. "db" keeps them in Postgres (default when no bucket is set).
ATTACHMENT_STORAGE=db
STORAGE_BUCKET=
# Optional: STORAGE_REGION (defaults to AWS_REGION), STORAGE_ENDPOINT for R2/MinIO
# (e.g. https://<account>.r2.cloudflarestorage.com), STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY
# (keys default to the AWS keys). Self-hosted S3 (MinIO, RustFS): STORAGE_FORCE_PATH_STYLE=true, and
# STORAGE_PUBLIC_ENDPOINT when browsers reach storage at a different address than the app
# (e.g. http://localhost:9000 vs http://s3:9000 inside Docker).

# ─── Operations ──────────────────────────────────────────────────────────────
# Operator alerts (background job failures, SES refusing mail, API 5xx). On in production.
# Recipients default to ADMIN_EMAILS; ALERT_WEBHOOK_URL accepts a Slack or Discord incoming webhook.
ALERT_EMAILS=
ALERT_WEBHOOK_URL=
# ALERTS=off
# Request rate limiting for the API, MCP and sign-in (per key/session, per IP). Set to "off" to disable.
# RATE_LIMIT=off
# Optional: single-value IP header overwritten by your CDN/edge proxy (e.g. cf-connecting-ip or x-real-ip).
# When unset, AGMX uses the right-most X-Forwarded-For hop appended by your reverse proxy (Caddy/Traefik/nginx).
# TRUSTED_IP_HEADER=

# ─── Development ─────────────────────────────────────────────────────────────
# Enables POST /api/dev/inbound to inject test mail (always on outside production).
ENABLE_DEV_INBOUND=false
